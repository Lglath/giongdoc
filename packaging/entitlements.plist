<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements, used only when signing with a Developer ID. -->
<plist version="1.0">
<dict>
    <!-- PyInstaller/Python need these under the hardened runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Recording a voice sample (custom voice) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- edge-tts talks to Microsoft's TTS service -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
